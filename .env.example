# ==============================================================================
# Environment Configuration Template - Experiment 10 MLOps Agent
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env':
#      cp .env.example .env (or Copy-Item .env.example .env in PowerShell)
# 2. Replace the placeholder values with your real credentials.
# 3. DO NOT commit your real '.env' file to Git (it is already in .gitignore).
# ==============================================================================

# Groq API Key (Obtain from https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Groq LLM Model (Supported models: llama-3.3-70b-versatile, llama-3.1-8b-instant)
GROQ_MODEL=llama-3.3-70b-versatile

# Application Port (Default: 8501 for local Streamlit, 7860 for Hugging Face Spaces)
PORT=8501
